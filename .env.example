# =============================================================
# XENITH — Variables de entorno
# Copia este archivo a .env para desarrollo local
# En Vercel configura cada variable en Project Settings > Environment Variables
# =============================================================

# ─────────────────────────────────────────────
# BASE DE DATOS (PostgreSQL)
# ─────────────────────────────────────────────

# Desarrollo local (Docker — ver docker-compose.yml)
DATABASE_URL="postgresql://xenith:xenith123@localhost:5432/xenith_db"
DIRECT_URL="postgresql://xenith:xenith123@localhost:5432/xenith_db"

# Producción: usa Neon (https://neon.tech) — crea un proyecto y copia las URLs
# DATABASE_URL usa el pooler (puerto 6432) para serverless/Vercel
# DIRECT_URL usa la conexión directa (puerto 5432) para migraciones
# DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL="postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ─────────────────────────────────────────────
# AUTH.JS (NextAuth v5)
# ─────────────────────────────────────────────

# Genera con: openssl rand -base64 32
AUTH_SECRET=""

# En desarrollo:
NEXTAUTH_URL="http://localhost:3000"

# En Vercel: pon la URL de tu deployment (ej: https://xenith.vercel.app)
# Vercel la detecta automáticamente desde VERCEL_URL, pero es bueno ser explícito
# NEXTAUTH_URL="https://tu-dominio.com"

# ─────────────────────────────────────────────
# APP
# ─────────────────────────────────────────────

# Misma URL que NEXTAUTH_URL (usada en el cliente)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# En producción: NEXT_PUBLIC_APP_URL="https://tu-dominio.com"

# ─────────────────────────────────────────────
# ADMIN SETUP
# Solo para crear el primer admin via /api/auth/register-admin
# ─────────────────────────────────────────────

# Email y contraseña del primer administrador
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Genera con: openssl rand -hex 32
# Pasar como header x-setup-key al endpoint de registro
ADMIN_SETUP_KEY=""

# Deshabilita el endpoint una vez creado el admin (pon "true" en producción)
ADMIN_SETUP_DISABLED="false"

# ─────────────────────────────────────────────
# EMAIL (Resend — https://resend.com)
# ─────────────────────────────────────────────

RESEND_API_KEY=""

# Remitente. El dominio debe estar verificado en Resend.
RESEND_FROM_EMAIL="Xenith <contacto@xenith.com.co>"

# Dónde llegan los avisos internos de nuevas solicitudes
CONTACT_TO_EMAIL="camilo.vargas@xenith.com.co"

# URL pública canónica: se usa para el logo y los enlaces DENTRO de los correos.
# Nunca localhost — los clientes de correo no pueden cargar imágenes de tu máquina.
NEXT_PUBLIC_SITE_URL="https://xenith.com.co"

# Formulario público — dos capas independientes:
#
# 1) Límite por IP: backstop contra inundaciones, no una cuota por persona.
#    Va alto porque en ferias todos comparten la IP del wifi del recinto.
#    Si esperas mucho tráfico desde una sola red, súbelo aún más esos días.
CONTACT_RATE_LIMIT_MAX="20"
CONTACT_RATE_LIMIT_WINDOW_MIN="60"
#
# 2) Ventana anti-duplicados por correo: cubre el doble clic y el reenvío
#    accidental. No es un bloqueo permanente — un cliente que escribió hace
#    meses puede volver a consultar por otro proyecto.
CONTACT_EMAIL_COOLDOWN_MIN="10"

# ─────────────────────────────────────────────
# CRON — cierre de ventanas de votación de puntos
# ─────────────────────────────────────────────

# Genera con: openssl rand -hex 32
# Sin este valor el endpoint /api/v1/cron/close-voting responde 401 siempre:
# preferimos que el cron falle ruidosamente a dejarlo abierto a internet.
CRON_SECRET=""

# Vercel: ya está declarado en vercel.json (cada hora en punto) y manda el
#   header Authorization: Bearer $CRON_SECRET automáticamente.
# Railway: crea un servicio cron con el comando `npm run cron:tick`, que corre
#   el mismo servicio en proceso y no necesita ni URL ni secreto. Si prefieres
#   pegarle por HTTP, manda el header x-cron-secret.
#
# El cron es solo la red de seguridad: las votaciones vencidas también se
# cierran solas cuando alguien abre el tablero del proyecto.
