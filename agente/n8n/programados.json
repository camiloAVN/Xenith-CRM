{
  "name": "Reto · Programados",
  "settings": { "executionOrder": "v1", "timezone": "America/Bogota" },
  "nodes": [
    {
      "id": "c1b2c3d4-0003-4000-8000-000000000001",
      "name": "Cada 15 min",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0],
      "parameters": { "rule": { "interval": [{ "field": "minutes", "minutesInterval": 15 }] } }
    },
    {
      "id": "c1b2c3d4-0003-4000-8000-000000000002",
      "name": "Auto-aprobar y recordatorios",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [240, 0],
      "parameters": { "operation": "executeQuery", "query": "select fn_tick() as acts", "options": {} },
      "credentials": { "postgres": { "id": "__PG_ID__", "name": "Postgres Reto" } }
    },
    {
      "id": "c1b2c3d4-0003-4000-8000-000000000003",
      "name": "12, 15, 18 y 21 h",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 200],
      "parameters": { "rule": { "interval": [{ "field": "cronExpression", "expression": "0 12,15,18,21 * * *" }] } }
    },
    {
      "id": "c1b2c3d4-0003-4000-8000-000000000004",
      "name": "Quién no ha subido evidencia",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [240, 200],
      "parameters": {
        "operation": "executeQuery",
        "query": "select fn_recordar_evidencias(extract(hour from now() at time zone 'America/Bogota')::int) as acts",
        "options": {}
      },
      "credentials": { "postgres": { "id": "__PG_ID__", "name": "Postgres Reto" } }
    },
    {
      "id": "c1b2c3d4-0003-4000-8000-000000000005",
      "name": "Domingo 7 pm",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 400],
      "parameters": { "rule": { "interval": [{ "field": "cronExpression", "expression": "0 19 * * 0" }] } }
    },
    {
      "id": "c1b2c3d4-0003-4000-8000-000000000006",
      "name": "Resumen semanal",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [240, 400],
      "parameters": { "operation": "executeQuery", "query": "select fn_resumen_semanal() as acts", "options": {} },
      "credentials": { "postgres": { "id": "__PG_ID__", "name": "Postgres Reto" } }
    },
    {
      "id": "c1b2c3d4-0003-4000-8000-000000000008",
      "name": "7 am",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 600],
      "parameters": { "rule": { "interval": [{ "field": "cronExpression", "expression": "0 7 * * *" }] } }
    },
    {
      "id": "c1b2c3d4-0003-4000-8000-000000000009",
      "name": "Pendientes de todos",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 600],
      "onError": "continueRegularOutput",
      "parameters": {
        "method": "GET",
        "url": "https://xenith.com.co/api/v1/bot/pendientes",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": { "timeout": 30000 }
      },
      "credentials": { "httpHeaderAuth": { "id": "__XENITH_CRED_ID__", "name": "Xenith Bot" } }
    },
    {
      "id": "c1b2c3d4-0003-4000-8000-00000000000a",
      "name": "Resumen de tareas",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [480, 600],
      "parameters": {
        "operation": "executeQuery",
        "query": "select fn_xenith_resumen($1::jsonb) as acts",
        "options": { "queryReplacement": "={{ [ $json ] }}" }
      },
      "credentials": { "postgres": { "id": "__PG_ID__", "name": "Postgres Reto" } }
    },
    {
      "id": "c1b2c3d4-0003-4000-8000-00000000000b",
      "name": "Cada 15 min (7–21 h)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 800],
      "parameters": { "rule": { "interval": [{ "field": "cronExpression", "expression": "*/15 7-21 * * *" }] } }
    },
    {
      "id": "c1b2c3d4-0003-4000-8000-00000000000c",
      "name": "Desde cuándo",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [240, 800],
      "parameters": {
        "operation": "executeQuery",
        "query": "select fn_xenith_sondeo_desde() as since",
        "options": {}
      },
      "credentials": { "postgres": { "id": "__PG_ID__", "name": "Postgres Reto" } }
    },
    {
      "id": "c1b2c3d4-0003-4000-8000-00000000000d",
      "name": "Novedades de Xenith",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 800],
      "onError": "continueRegularOutput",
      "parameters": {
        "method": "GET",
        "url": "https://xenith.com.co/api/v1/bot/pendientes",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": { "parameters": [{ "name": "since", "value": "={{ $json.since }}" }] },
        "options": { "timeout": 30000 }
      },
      "credentials": { "httpHeaderAuth": { "id": "__XENITH_CRED_ID__", "name": "Xenith Bot" } }
    },
    {
      "id": "c1b2c3d4-0003-4000-8000-00000000000e",
      "name": "Avisos de tareas",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [720, 800],
      "parameters": {
        "operation": "executeQuery",
        "query": "select fn_xenith_novedades($1::jsonb) as acts",
        "options": { "queryReplacement": "={{ [ $json ] }}" }
      },
      "credentials": { "postgres": { "id": "__PG_ID__", "name": "Postgres Reto" } }
    },
    {
      "id": "c1b2c3d4-0003-4000-8000-000000000007",
      "name": "Ejecutar acciones",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [520, 200],
      "parameters": {
        "source": "database",
        "workflowId": { "__rl": true, "value": "__SUB_ID__", "mode": "id" },
        "mode": "once",
        "options": { "waitForSubWorkflow": true }
      }
    }
  ],
  "connections": {
    "Cada 15 min": { "main": [[{ "node": "Auto-aprobar y recordatorios", "type": "main", "index": 0 }]] },
    "Auto-aprobar y recordatorios": { "main": [[{ "node": "Ejecutar acciones", "type": "main", "index": 0 }]] },
    "12, 15, 18 y 21 h": { "main": [[{ "node": "Quién no ha subido evidencia", "type": "main", "index": 0 }]] },
    "Quién no ha subido evidencia": { "main": [[{ "node": "Ejecutar acciones", "type": "main", "index": 0 }]] },
    "Domingo 7 pm": { "main": [[{ "node": "Resumen semanal", "type": "main", "index": 0 }]] },
    "Resumen semanal": { "main": [[{ "node": "Ejecutar acciones", "type": "main", "index": 0 }]] },
    "7 am": { "main": [[{ "node": "Pendientes de todos", "type": "main", "index": 0 }]] },
    "Pendientes de todos": { "main": [[{ "node": "Resumen de tareas", "type": "main", "index": 0 }]] },
    "Resumen de tareas": { "main": [[{ "node": "Ejecutar acciones", "type": "main", "index": 0 }]] },
    "Cada 15 min (7–21 h)": { "main": [[{ "node": "Desde cuándo", "type": "main", "index": 0 }]] },
    "Desde cuándo": { "main": [[{ "node": "Novedades de Xenith", "type": "main", "index": 0 }]] },
    "Novedades de Xenith": { "main": [[{ "node": "Avisos de tareas", "type": "main", "index": 0 }]] },
    "Avisos de tareas": { "main": [[{ "node": "Ejecutar acciones", "type": "main", "index": 0 }]] }
  }
}
