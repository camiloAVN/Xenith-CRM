{
  "name": "Reto · Agente IA",
  "settings": { "executionOrder": "v1", "timezone": "America/Bogota", "callerPolicy": "workflowsFromSameOwner" },
  "nodes": [
    {
      "id": "e1b2c3d4-0005-4000-8000-000000000001",
      "name": "Recibe",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [0, 0],
      "parameters": { "inputSource": "passthrough" }
    },
    {
      "id": "e1b2c3d4-0005-4000-8000-000000000002",
      "name": "Preparar",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [240, 0],
      "parameters": {
        "operation": "executeQuery",
        "query": "select r, r -> 'acts' as acts from fn_agente_preparar($1::jsonb) r",
        "options": { "queryReplacement": "={{ [ $json.params ] }}" }
      },
      "credentials": { "postgres": { "id": "__PG_ID__", "name": "Postgres Reto" } }
    },
    {
      "id": "e1b2c3d4-0005-4000-8000-000000000003",
      "name": "¿Dentro del límite?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [480, 0],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose", "version": 2 },
          "conditions": [
            {
              "id": "e1b2c3d4-0005-4000-8000-0000000000aa",
              "leftValue": "={{ $json.r.ok }}",
              "rightValue": "",
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "e1b2c3d4-0005-4000-8000-000000000004",
      "name": "Claude",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, -100],
      "onError": "continueRegularOutput",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 3000,
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "anthropic-version", "value": "2023-06-01" }] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.r.body) }}",
        "options": { "timeout": 45000 }
      },
      "credentials": { "httpHeaderAuth": { "id": "__ANTHROPIC_CRED_ID__", "name": "Anthropic" } }
    },
    {
      "id": "e1b2c3d4-0005-4000-8000-000000000005",
      "name": "Responder",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [960, -100],
      "parameters": {
        "operation": "executeQuery",
        "query": "select fn_agente_responder($1::jsonb, $2::jsonb) as acts",
        "options": { "queryReplacement": "={{ [ $('Preparar').item.json.r.ctx, $json ] }}" }
      },
      "credentials": { "postgres": { "id": "__PG_ID__", "name": "Postgres Reto" } }
    },
    {
      "id": "e1b2c3d4-0005-4000-8000-000000000006",
      "name": "Ejecutar acciones",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [1200, 0],
      "parameters": {
        "source": "database",
        "workflowId": { "__rl": true, "value": "__SUB_ID__", "mode": "id" },
        "mode": "once",
        "options": { "waitForSubWorkflow": true }
      }
    }
  ],
  "connections": {
    "Recibe": { "main": [[{ "node": "Preparar", "type": "main", "index": 0 }]] },
    "Preparar": { "main": [[{ "node": "¿Dentro del límite?", "type": "main", "index": 0 }]] },
    "¿Dentro del límite?": {
      "main": [
        [{ "node": "Claude", "type": "main", "index": 0 }],
        [{ "node": "Ejecutar acciones", "type": "main", "index": 0 }]
      ]
    },
    "Claude": { "main": [[{ "node": "Responder", "type": "main", "index": 0 }]] },
    "Responder": { "main": [[{ "node": "Ejecutar acciones", "type": "main", "index": 0 }]] }
  }
}
