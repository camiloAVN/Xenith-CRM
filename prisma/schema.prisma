// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model (managed by Auth.js)
model User {
  id                String    @id @default(cuid())
  name              String?
  email             String    @unique
  emailVerified     DateTime?
  image             String?
  password          String? // For credentials provider
  role              UserRole  @default(USER)
  position          String? // Cargo del usuario
  isActive          Boolean   @default(true)
  // Permiso opcional que solo el SUPERADMIN (el dueno) puede otorgar: deja que
  // un ADMIN cree proyectos. Por defecto nadie mas que el dueno puede.
  canCreateProjects Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  accounts            Account[]
  sessions            Session[]
  projects            Project[]
  quotations          Quotation[]
  assignedTasks       Task[]                   @relation("TaskAssignee")
  reportedTasks       Task[]                   @relation("TaskReporter")
  taskComments        TaskComment[]
  taskHistory         TaskHistory[]
  taskAttachments     TaskAttachment[]
  projectMembers      ProjectMember[]
  earnings            Earning[]                @relation("UserEarnings")
  pointVotes          TaskPointVote[]          @relation("TaskPointVotes")
  taskApprovals       TaskCompletionApproval[] @relation("TaskApprovals")
  pointLedger         PointLedgerEntry[]       @relation("PointLedger")
  pointLedgerAuthored PointLedgerEntry[]       @relation("PointLedgerAuthor")
  settingsUpdated     ContributionSettings[]   @relation("SettingsAuthor")

  @@map("users")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_tokens")
}

// Client model
model Client {
  id        String   @id @default(cuid())
  name      String
  company   String?
  email     String   @unique
  phone     String?
  address   String?
  city      String?
  country   String?
  taxId     String? // RFC or tax identification
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  projects   Project[]
  quotations Quotation[]

  @@map("clients")
}

// Project model
model Project {
  id          String        @id @default(cuid())
  title       String
  description String        @db.Text
  status      ProjectStatus @default(PROSPECT)
  clientId    String?
  assignedTo  String
  startDate   DateTime?
  endDate     DateTime?
  budget      Decimal?      @db.Decimal(10, 2)
  priority    Priority      @default(MEDIUM)
  tags        String[]      @default([])
  notes       String?       @db.Text
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Relations
  client               Client?               @relation(fields: [clientId], references: [id], onDelete: SetNull)
  assignedUser         User                  @relation(fields: [assignedTo], references: [id], onDelete: Restrict)
  quotations           Quotation[]
  tasks                Task[]
  members              ProjectMember[]
  earnings             Earning[]
  pointLedger          PointLedgerEntry[]
  contributionSettings ContributionSettings?

  @@index([clientId])
  @@index([assignedTo])
  @@index([status])
  @@map("projects")
}

// Task model (sub-tasks for projects) — full Jira-style
model Task {
  id             String     @id @default(cuid())
  projectId      String
  title          String
  description    String?    @db.Text
  status         TaskStatus @default(TODO)
  priority       Priority   @default(MEDIUM)
  assignedTo     String?
  reporterId     String?
  dueDate        DateTime?
  estimatedHours Float?
  actualHours    Float?
  order          Int        @default(0)
  tags           String[]   @default([])
  completed      Boolean    @default(false)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  // -- Valoracion por puntos --------------------------------------------
  // La ventana de votacion se abre una sola vez, al crear la tarea, y cierra
  // seco al vencer: no se extiende ni se reabre. Sin quorum -> minPoints.
  valuationStatus TaskValuationStatus @default(VOTING)
  votingClosesAt  DateTime?
  pointsValue     Decimal?            @db.Decimal(5, 2) // mediana de los votos
  needsDiscussion Boolean             @default(false) // aviso, no bloquea

  // -- Cumplimiento ------------------------------------------------------
  completionStatus TaskCompletionStatus @default(PENDING)
  completionRound  Int                  @default(1) // ++ en cada rechazo
  submittedAt      DateTime?
  acceptedAt       DateTime?
  lastRejectedAt   DateTime?

  // -- Penalizacion por retraso ------------------------------------------
  // Acumulador de tramos cerrados + marca del tramo abierto: el reloj se pausa
  // al marcar "terminada" y se reanuda en cada rechazo. Solo cuenta el tiempo
  // posterior a dueDate, por dias completos.
  lateAccruedDays    Decimal   @default(0) @db.Decimal(8, 3)
  lateClockStartedAt DateTime?
  effectivePoints    Decimal?  @db.Decimal(5, 2) // snapshot al aceptar

  // Relations
  project       Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignedUser  User?                    @relation("TaskAssignee", fields: [assignedTo], references: [id], onDelete: SetNull)
  reporter      User?                    @relation("TaskReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  comments      TaskComment[]
  attachments   TaskAttachment[]
  history       TaskHistory[]
  pointVotes    TaskPointVote[]
  approvals     TaskCompletionApproval[]
  ledgerEntries PointLedgerEntry[]

  @@index([projectId])
  @@index([assignedTo])
  @@index([status])
  @@index([dueDate])
  @@map("tasks")
}

// Task Comments
model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("task_comments")
}

// Task Attachments (stub — no upload UI yet)
model TaskAttachment {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  filename  String
  url       String
  size      Int
  mimeType  String
  createdAt DateTime @default(now())

  // Relations
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("task_attachments")
}

// Task History (audit log)
model TaskHistory {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  field     String // status, assigned_to, due_date, priority
  oldValue  String?
  newValue  String?
  createdAt DateTime @default(now())

  // Relations
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("task_history")
}

// Project Members
model ProjectMember {
  id        String      @id @default(cuid())
  projectId String
  userId    String
  role      ProjectRole @default(DEVELOPER)
  createdAt DateTime    @default(now())

  // Relations
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_members")
}

// Quotation model
model Quotation {
  id              String          @id @default(cuid())
  quotationNumber String          @unique // QT-2026-0001
  title           String
  description     String?         @db.Text
  clientId        String
  projectId       String?
  createdBy       String
  status          QuotationStatus @default(DRAFT)
  validUntil      DateTime
  subtotal        Decimal         @db.Decimal(10, 2)
  tax             Decimal         @db.Decimal(10, 2)
  discount        Decimal         @default(0) @db.Decimal(10, 2)
  total           Decimal         @db.Decimal(10, 2)
  notes           String?         @db.Text
  terms           String?         @db.Text
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  // Relations
  client        Client          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  project       Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdByUser User            @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  items         QuotationItem[]

  @@index([clientId])
  @@index([projectId])
  @@index([createdBy])
  @@map("quotations")
}

// Quotation items
model QuotationItem {
  id          String   @id @default(cuid())
  quotationId String
  description String
  quantity    Int
  unitPrice   Decimal  @db.Decimal(10, 2)
  total       Decimal  @db.Decimal(10, 2)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
  @@map("quotation_items")
}

// Solicitudes del formulario público de cotización
model ContactRequest {
  id        String     @id @default(cuid())
  name      String
  email     String
  phone     String?
  company   String?
  message   String?    @db.Text
  status    LeadStatus @default(NEW)
  // De qué formulario vino: el general de la web o la landing de Vector.
  source    LeadSource @default(WEB)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  // Sin @unique en email: una misma persona puede escribir varias veces
  // y un choque de constraint significaría perder un lead. La deduplicación
  // es por ventana de tiempo y se apoya en el índice compuesto de abajo.
  @@index([email, createdAt])
  @@index([status])
  @@index([createdAt])
  @@map("contact_requests")
}

// Earnings model
model Earning {
  id          String      @id @default(cuid())
  description String
  amount      Decimal     @db.Decimal(14, 2) // positivo = ingreso / ganancia; negativo = deducción
  type        EarningType
  projectId   String?
  userId      String? // solo para USER_EARNING — a quién pertenece
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  user    User?    @relation("UserEarnings", fields: [userId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([userId])
  @@map("earnings")
}

// ---------------------------------------------------------------------------
// Sistema de puntos de aporte
// ---------------------------------------------------------------------------

// Voto de un miembro sobre el valor en puntos de una tarea.
// Vota todo el equipo del proyecto EXCEPTO el asignado (un jefe autoasignado
// tambien queda excluido). Un voto por persona, editable mientras la ventana
// siga abierta.
model TaskPointVote {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  value     Int // entero dentro del rango configurado (default 2-10)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation("TaskPointVotes", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([taskId])
  @@map("task_point_votes")
}

// Aprobacion (o rechazo) de un jefe sobre el cumplimiento de una tarea.
// `round` se incrementa en cada rechazo para que las aprobaciones del ciclo
// anterior no cuenten en el nuevo intento.
model TaskCompletionApproval {
  id        String   @id @default(cuid())
  taskId    String
  userId    String // jefe de proyecto
  round     Int      @default(1)
  approved  Boolean // false = rechazo
  comment   String?  @db.Text
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation("TaskApprovals", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId, round])
  @@index([taskId])
  @@map("task_completion_approvals")
}

// Ledger de puntos por proyecto. Append-only: reabrir una tarea aceptada NO
// borra el credito, escribe una fila TASK_REVERTED en negativo. Eso mantiene
// la auditoria y congela el saldo de quien sale del proyecto.
model PointLedgerEntry {
  id          String          @id @default(cuid())
  projectId   String
  userId      String
  taskId      String?
  type        PointLedgerType
  points      Decimal         @db.Decimal(8, 2) // + acredita, - revierte
  note        String?
  createdById String?
  createdAt   DateTime        @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User    @relation("PointLedger", fields: [userId], references: [id], onDelete: Restrict)
  task      Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)
  createdBy User?   @relation("PointLedgerAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([projectId, userId])
  @@index([taskId])
  @@map("point_ledger_entries")
}

// Parametros del sistema de puntos. La fila con projectId = null es la
// configuracion global que edita el dueno; una fila con projectId la
// sobrescribe para ese proyecto.
model ContributionSettings {
  id                String   @id @default(cuid())
  projectId         String?  @unique
  minVotes          Int      @default(2)
  minPoints         Int      @default(2)
  maxPoints         Int      @default(10)
  penaltyPerDay     Decimal  @default(0.2) @db.Decimal(5, 2)
  penaltyFloorRatio Decimal  @default(0.5) @db.Decimal(3, 2)
  disagreementDelta Int      @default(5)
  votingWindowHours Int      @default(24)
  updatedById       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  updatedBy User?    @relation("SettingsAuthor", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("contribution_settings")
}

// Enums
enum ProjectStatus {
  PROSPECT // Prospecto
  IN_PROGRESS // En progreso
  ON_HOLD // En pausa
  COMPLETED // Completado
  CANCELLED // Cancelado
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
  BLOCKED
}

enum QuotationStatus {
  DRAFT // Borrador
  SENT // Enviada
  ACCEPTED // Aceptada
  REJECTED // Rechazada
  EXPIRED // Expirada
}

enum UserRole {
  SUPERADMIN // Solo camilo.vargas@xenith.com.co
  ADMIN // Administradores
  USER // Usuarios normales
}

enum EarningType {
  COMPANY_INCOME // Ingreso de la empresa (solo visible en detalle para SUPERADMIN)
  DEDUCTION // Gasto operativo / impuesto (amount negativo)
  USER_EARNING // Ganancia personal de un usuario
}

enum ProjectRole {
  ADMIN
  PROJECT_MANAGER
  DEVELOPER
  VIEWER
}

enum LeadSource {
  WEB // Formulario general de /inicio
  VECTOR // Landing de Xenith Vector
}

enum LeadStatus {
  NEW // Recién recibido
  CONTACTED // Ya se le respondió
  QUALIFIED // Prospecto real
  CONVERTED // Se volvió cliente
  DISCARDED // Descartado
}

enum TaskValuationStatus {
  VOTING // ventana de votacion abierta
  EXTENDED // extendida 24h por falta de quorum (solo una vez)
  VALUED // valor en puntos ya fijado
}

enum TaskCompletionStatus {
  PENDING // en progreso / reabierta tras rechazo
  SUBMITTED // el asignado la marco "terminada", esperando a los jefes
  ACCEPTED // aprobada por los jefes requeridos, puntos acreditados
}

enum PointLedgerType {
  TASK_ACCEPTED // credito por tarea aceptada
  TASK_REVERTED // reverso: tarea reabierta despues de aceptada
  SEED // back-fill de trabajo previo al sistema
  ADJUSTMENT // ajuste manual del dueno
}
